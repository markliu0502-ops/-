# Copy to .env.local. Never commit the local env file or its values.
# Keep these server-only keys out of browser code.
SEOUL_API_KEY=
# Use the decoded key from data.go.kr; the server URL-encodes it.
DATA_GO_KR_API_KEY=
KAKAO_REST_API_KEY=

# Kakao Maps JavaScript key is browser-visible; restrict its allowed web domains.
NEXT_PUBLIC_KAKAO_JS_KEY=
